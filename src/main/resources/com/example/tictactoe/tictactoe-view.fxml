                     </color>
                  </Stop>
                  <Stop offset="1.0">
                     <color>
                        <Color red="0.19566276669502258" green="0.33588775992393494" blue="0.9605262875556946" />
                     </color>
                  </Stop>
               </stops>
            </LinearGradient>
         </textFill>
      </Label>
   </top>
   <bottom>
      <Label fx:id="labelInfo" alignment="CENTER" prefHeight="29.0" prefWidth="450.0" text="Es ist X's Zug!" visible="false" BorderPane.alignment="CENTER">
